{
  "name": "vienna-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Vienna public transport (Wiener Linien) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=8192 pipeline/build.mjs --all --tram all",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8136"
  }
}
